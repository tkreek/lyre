pkgname=lyre
pkgver=0.1.0
pkgrel=1
pkgdesc='Keyboard-first Jellyfin music player for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'qt6-svg')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lyre "$pkgdir/usr/bin/lyre"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/lyre.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lyre.svg"
  install -Dm644 "$startdir/lyre.desktop" "$pkgdir/usr/share/applications/lyre.desktop"
}
